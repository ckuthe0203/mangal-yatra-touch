# Copy this file to backend/secrets.env and fill it in. secrets.env is git-ignored: never commit it.
# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio phone number (E.164 format, with country code)
TWILIO_FROM=+15551234567
# The phone that plays Mission Control. On a trial account it must be a Verified Caller ID in Twilio.
MISSION_CONTROL_PHONE=+919999999999
# 1 = also phone Mission Control on SOS (robot voice reads the alert)
MISSION_CONTROL_CALL=0
# Demo: signal delay in seconds (the real Earth-Mars delay is 5-22 minutes). Remove for the real delay.
EARTH_DELAY_S=20

# Gemini API (Mission Control on Earth): free key from https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
